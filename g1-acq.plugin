#!name=G1 ACQ
#!desc=Google One /ai 订阅页商品 ID 映射至真实存在的优惠档(20TB/30TB AI Ultra)，不含诊断与上报
#!system=ios

[Rule]
# 屏蔽 QUIC(UDP 443)，避免 Google App 走 HTTP/3 导致响应无法解密
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Script]
http-response ^https:\/\/one\.google\.com\/ai\? script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@main/g1-acq.js, requires-body=true, timeout=10, tag=g1-acq

[MitM]
hostname = one.google.com
